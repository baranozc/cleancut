GENIUS_API_KEY="your_api_key-here"

# HuggingFace'e bağlanmadan bilgisayardaki modeli kullan (model ilk kez indirilecekse 0 yapın)
HF_HUB_OFFLINE=1

# İsteğe bağlı API varsayılanları
# CLEANCUT_DEVICE=cpu
# CLEANCUT_LANGUAGE=tr
# CLEANCUT_COMPUTE_TYPE=int8
# OLLAMA_MODEL=gemma4:e4b
# OLLAMA_URL=http://localhost:11434/v1/chat/completions
# Kesim modu: full_bars (tam ölçü, ritim en doğal) | even_beats (çift vuruş, daha az söz gider)
# CLEANCUT_CUT_MODE=full_bars
